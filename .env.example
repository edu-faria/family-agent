# Copy to .env and fill in. .env is git-ignored.

# --- Telegram -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# --- LLM providers -----------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Access control --------------------------------------------------------
# Comma-separated numeric Telegram user IDs allowed to talk to the bot.
# Get yours by messaging @userinfobot. Everyone else is refused before any LLM call.
FAMILY_ALLOWLIST=111111111,222222222

# Optional: pretty names + reply locale per member, "id:Name:locale" comma-separated.
FAMILY_MEMBERS=111111111:Rafael:pt,222222222:Anna:de

# --- Optional overrides (defaults live in config.toml) -------------------
# FAMILY_AGENT_TIMEZONE=Europe/Berlin
# FAMILY_AGENT_DEFAULT_LOCALE=pt
# FAMILY_AGENT_DB_PATH=/data/family.db
# FAMILY_AGENT_LOG_LEVEL=INFO
# FAMILY_AGENT_AGENT__PRIMARY_MODEL=claude-sonnet-5
